generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())

  boards        Board[]
  boardMembers  BoardMember[]
  comments      Comment[]
  listingsAdded Listing[]  @relation("ListingsAdded")
  favorites     Favorite[]
}

model Board {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())

  owner    User          @relation(fields: [ownerId], references: [id])
  members  BoardMember[]
  listings Listing[]
  tags     Tag[]
  invites  BoardInvite[]
  pins     BoardPin[]
}

model BoardMember {
  id      String @id @default(cuid())
  boardId String
  userId  String
  role    Role   @default(COLLABORATOR)

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([boardId, userId])
}

enum Role {
  OWNER
  COLLABORATOR
}

enum ListingStatus {
  NEW
  VIEWING
  APPLIED
  REJECTED
  ACCEPTED
  UNAVAILABLE_TIMEFRAME
  DELISTED
}

model Listing {
  id          String   @id @default(cuid())
  boardId     String
  addedById   String?
  title       String
  sourceUrl   String?
  price       Int?
  size        Float?
  location    String?
  description String?
  imageUrls   String[]
  latitude    Float?
  longitude   Float?
  status      ListingStatus @default(NEW)
  createdAt   DateTime @default(now())

  board     Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  addedBy   User?        @relation("ListingsAdded", fields: [addedById], references: [id], onDelete: SetNull)
  tags      ListingTag[]
  comments  Comment[]
  favorites Favorite[]
}

model Tag {
  id      String @id @default(cuid())
  name    String
  boardId String

  board    Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  listings ListingTag[]

  @@unique([boardId, name])
}

model ListingTag {
  listingId String
  tagId     String

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([listingId, tagId])
}

model BoardPin {
  id        String @id @default(cuid())
  boardId   String
  name      String
  latitude  Float
  longitude Float

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
}

model BoardInvite {
  id        String   @id @default(cuid())
  boardId   String
  email     String
  createdAt DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([boardId, email])
}

model Favorite {
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
}

model Comment {
  id        String   @id @default(cuid())
  listingId String
  userId    String
  content   String
  parentId  String?
  createdAt DateTime @default(now())

  listing Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id])
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")
}
